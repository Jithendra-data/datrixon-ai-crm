{
  "name": "datrixon-ai-crm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint app components/crm lib/crm db tests static-demo --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write app components/crm lib/crm db tests docs README.md static-demo",
    "format:check": "prettier --check app components/crm lib/crm db tests docs README.md static-demo",
    "db:migrate": "node scripts/migrate.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check && npm run build",
    "db:seed": "node scripts/seed.mjs",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sql.js": "^1.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261005.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.6.0",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.147.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
