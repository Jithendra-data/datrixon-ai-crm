# Optional server-only narrative configuration. Pages never loads these values.
# Put local secrets in .dev.vars (ignored), or use your worker secret manager.
# All three must be configured; deterministic answers work without them.
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=
AI_API_KEY=
# Never put API keys in VITE_* or NEXT_PUBLIC_* variables.
